{
  "name": "sentinel",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive intelligence exploration platform",
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "ingest": "npm run ingest -w server",
    "start": "npm run build -w web && npm start -w server",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "check": "npm run typecheck && npm test && npm run build"
  }
}
