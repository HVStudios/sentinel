{
  "name": "sentinel",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive intelligence exploration platform",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "ingest": "npm run ingest -w server",
    "start": "npm run build -w web && npm start -w server",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e --noEmit",
    "test": "npm test --workspaces",
    "check": "npm run typecheck && npm test && npm run build",
    "export": "npm run export -w server",
    "build:static": "npm run export && VITE_STATIC=1 npm run build -w web",
    "e2e": "node e2e/prepare.mjs && playwright test",
    "e2e:test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
