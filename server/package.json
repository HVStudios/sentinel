{
  "name": "@sentinel/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/main.ts",
    "ingest": "node --disable-warning=ExperimentalWarning src/cli/ingest.ts",
    "export": "node --disable-warning=ExperimentalWarning src/cli/export.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
